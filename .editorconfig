root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 140

[*.{kt,kts}]
# ktlint: standard + Compose-friendly
ktlint_standard_no-wildcard-imports = disabled
ktlint_standard_function-naming = disabled
ktlint_standard_annotation = enabled
ktlint_standard_multiline-expression = enabled
ij_kotlin_imports_layout = *
ij_kotlin_use_field_for_property_access = false
ktlint_disabled_rules = no-wildcard-imports,function-naming,annotation

[*.{yml,yaml}]
indent_size = 2

[*.{md,markdown}]
max_line_length = off
trim_trailing_whitespace = false

[*.{json,toml}]
indent_size = 2

[Makefile]
indent_style = tab
